+#[test]
+fn compact_peer_uses_retained_activity_expansion() {
+    let cell = crate::history_cell::messages::compact_peer_tests::fixture();
+    let mut view = TranscriptView::default();
+    let collapsed = view.content_presentation(&cell, false, HistoryRenderMode::Rich);
+    assert!(collapsed.disclosure);
+    assert!(!collapsed.expanded);
+    let layout = cell_content_layout(&cell, 80, HistoryRenderMode::Rich, collapsed, None);
+    assert!(layout.text().contains("from quiet-otter: Beginning"));
+    assert!(!layout.text().contains("[ai-sessions"));
+    view.disclosure.expanded.extend(cell.activity_ids());
+    let expanded = view.content_presentation(&cell, false, HistoryRenderMode::Rich);
+    assert!(expanded.disclosure && expanded.expanded);
+    let layout = cell_content_layout(&cell, 80, HistoryRenderMode::Rich, expanded, None);
+    assert!(layout.text().contains("Hidden second paragraph"));
+    assert!(!layout.text().contains("sessions reply"));
+    view.disclosure.expanded.clear();
+    assert!(!view.content_presentation(&cell, false, HistoryRenderMode::Rich).expanded);
+}
