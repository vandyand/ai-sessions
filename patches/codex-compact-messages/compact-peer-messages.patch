+#[test]
+fn compact_peer_retained_entry_layout_reflows_after_toggle() {
+    let cell = Arc::new(crate::history_cell::messages::compact_peer_tests::fixture());
+    let cells: Vec<Arc<dyn HistoryCell>> = vec![cell.clone()];
+    let mut view = TranscriptView::default();
+    view.area = ratatui::layout::Rect::new(0, 0, 48, 20);
+    let collapsed = view.entry_layout(&cells, 0, false).unwrap();
+    assert!(!collapsed.text().contains("Hidden second paragraph"));
+    assert_eq!(collapsed.row_count(), 1);
+    assert_eq!(collapsed.disclosure_row(), Some(0));
+    assert!(collapsed.disclosure_columns().contains(&0));
+    assert_eq!(collapsed.rewrap(48).row_count(), 1);
+    assert_eq!(collapsed.rewrap(16).row_count(), 1);
+    view.disclosure.expanded.extend(cell.activity_ids());
+    let expanded = view.entry_layout(&cells, 0, false).unwrap();
+    assert!(expanded.text().contains("Hidden second paragraph"));
+    assert!(!expanded.text().contains("[ai-sessions"));
+    view.disclosure.expanded.clear();
+    let collapsed_again = view.entry_layout(&cells, 0, false).unwrap();
+    assert_eq!(collapsed.text(), collapsed_again.text());
+}
