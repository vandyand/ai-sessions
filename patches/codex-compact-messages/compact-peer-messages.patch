+#[test]
+fn compact_peer_preview_row_toggles_native_disclosure() {
+    let cell = Arc::new(crate::history_cell::messages::compact_peer_tests::fixture());
+    let mut second = crate::history_cell::messages::compact_peer_tests::fixture();
+    second.message = second.message.replace("123456789abc", "123456789abd");
+    let cells: Vec<Arc<dyn HistoryCell>> = vec![cell, Arc::new(second)];
+    let mut view = TranscriptView::default();
+    let area = ratatui::layout::Rect::new(0, 0, 48, 20);
+    let mut buf = ratatui::buffer::Buffer::empty(area);
+    view.render(area, &mut buf, &cells);
+    for index in 0..2 {
+        assert_eq!(view.entry_layout(&cells, index, false).unwrap().row_count(), 1);
+    }
+    let (column, row) = crate::transcript_view::tests::text(&buf)
+        .lines().enumerate()
+        .find_map(|(row, line)| line.find("from quiet-otter:").map(|column| (column, row)))
+        .expect("peer preview row");
+    assert!(view.toggle_disclosure_at(&cells, column as u16, row as u16));
+    assert!(view.entry_layout(&cells, 0, false).unwrap().text().contains("Hidden second paragraph"));
+    view.render(area, &mut buf, &cells);
+    view.disclosure.expanded.clear();
+    assert_eq!(view.entry_layout(&cells, 0, false).unwrap().row_count(), 1);
+}
